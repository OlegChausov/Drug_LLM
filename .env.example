# =============================================================================
# Ollama — LLM (запускается на ХОСТЕ, не в Docker)
# =============================================================================
#
# 1. Установите Ollama: https://ollama.com/download
# 2. Скачайте модели из MODEL и MODEL_NER:
#      ollama pull qwen2.5:7b-instruct
# 3. ВАЖНО: контейнер приложения обращается к Ollama по host.docker.internal,
#    поэтому Ollama должна слушать все интерфейсы, а не только 127.0.0.1:
#      Linux:   systemctl edit ollama  ->  [Service] Environment="OLLAMA_HOST=0.0.0.0:11434"
#      Windows: setx OLLAMA_HOST 0.0.0.0:11434   (затем перезапустить Ollama)
#
# В docker compose эта переменная переопределяется на http://host.docker.internal:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Основная модель
# Варианты: qwen3:1.7b (быстро), qwen3:4b (баланс), qwen2.5:7b-instruct (умно)
# ВАЖНО: qwen2.5 НЕ поддерживает reasoning. Не указывайте reasoning=False.
MODEL=qwen2.5:7b-instruct
MODEL_NER=qwen2.5:7b-instruct

# =============================================================================
# Qdrant — векторная БД
# =============================================================================
# В docker compose QDRANT_URL переопределяется на http://qdrant:6333
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=drugs
QDRANT_TIMEOUT=120
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Версия сервера. Должна совпадать с версией, создавшей данные на Hugging Face,
# иначе Qdrant не откроет скачанные коллекции.
QDRANT_VERSION=v1.19.1

# =============================================================================
# Neo4j — граф знаний
# =============================================================================
# В docker compose NEO4J_URI переопределяется на bolt://neo4j:7687
NEO4J_URI=bolt://127.0.0.1:7687

# Пароль применяется к скачанной базе при первом запуске
# (storage-init удаляет старый dbms/auth.ini и Neo4j задаёт пароль из этой строки).
# Требования: минимум 8 символов; только латиница, цифры и _ (без $, кавычек, пробелов).
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_for_drugs
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512m

# Версия сервера. Должна совпадать с версией, создавшей данные на Hugging Face
# (базу новее этой версии Neo4j открыть не сможет).
NEO4J_VERSION=2026.09.0

# =============================================================================
# Эмбеддинги
# =============================================================================

EMBED_MODEL_NAME=intfloat/multilingual-e5-large

# =============================================================================
# RAG
# =============================================================================

TOP_K_CHUNKS=3
MAX_GRAPH_EDGES=40

# =============================================================================
# Hugging Face — автозагрузка баз в Docker
# =============================================================================
#
# При первом `docker compose up` скачивается ~740 МБ в ./storage.
# Повторно не скачивается, пока существует storage/.ready.
# Токен не нужен для публичного датасета; создать при ошибке 429 (rate limit)
# или для приватного репозитория: https://huggingface.co/settings/tokens (role: read)
HF_TOKEN=
HF_REPO_ID=OlegChausov/drug-llm-storage